# ============================================================
#  TEACHIUM AI Tutor - Modele de configuration
#  Copiez ce fichier vers  backend/.env  puis completez les valeurs.
#  Le fichier .env ne doit JAMAIS etre commite (voir .gitignore).
# ============================================================

# --- Base de donnees : PostgreSQL heberge sur Neon --------------------------
# Aucune installation locale de PostgreSQL n'est necessaire.
# Console Neon > votre projet > Connection Details > copier la chaine.
# Exemple de format (remplacez par la votre) :
#   postgresql://neondb_owner:MOT_DE_PASSE@ep-xxxx-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Authentification -------------------------------------------------------
# Cle secrete de signature des jetons JWT. Generez-en une avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# --- CORS : origines autorisees du frontend React (Vite) --------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Optionnel : integration d'un LLM ---------------------------------------
# NON REQUIS par le prototype actuel. L'AI Tutor fonctionne aujourd'hui avec un
# moteur a base de regles (mots-cles) couple aux modeles scikit-learn.
# Ces variables sont reservees a une integration future (voir
# backend/app/services/tutor_service.py, classe TutorEngine).
LLM_API_KEY=
LLM_MODEL=

# --- Debogage ---------------------------------------------------------------
# Mettre a true pour afficher toutes les requetes SQL dans la console.
SQL_ECHO=false
